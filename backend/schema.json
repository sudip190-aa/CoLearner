components:
  schemas:
    PatchedUserDetail:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        username:
          type: string
          maxLength: 150
        full_name:
          type: string
          maxLength: 150
        avatar:
          type: string
          format: uri
          nullable: true
        headline:
          type: string
          maxLength: 200
        location:
          type: string
          maxLength: 100
        role:
          $ref: '#/components/schemas/RoleEnum'
        xp:
          type: integer
        level:
          type: integer
        streak_days:
          type: integer
        is_verified:
          type: boolean
        skills:
          type: string
          readOnly: true
        badges:
          type: string
          readOnly: true
        email:
          type: string
          format: email
          maxLength: 254
        bio:
          type: string
        github:
          oneOf:
          - type: string
            format: uri
            maxLength: 200
          - type: string
            maxLength: 0
        linkedin:
          oneOf:
          - type: string
            format: uri
            maxLength: 200
          - type: string
            maxLength: 0
        website:
          oneOf:
          - type: string
            format: uri
            maxLength: 200
          - type: string
            maxLength: 0
        availability:
          type: string
          maxLength: 50
        interests: {}
        last_active:
          type: string
          format: date-time
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        stats:
          type: string
          readOnly: true
    RoleEnum:
      enum:
      - learner
      - builder
      - mentor
      - admin
      type: string
      description: |-
        * `learner` - Learner
        * `builder` - Builder
        * `mentor` - Mentor
        * `admin` - Admin
    TokenRefresh:
      type: object
      properties:
        access:
          type: string
          readOnly: true
        refresh:
          type: string
      required:
      - access
      - refresh
    UserDetail:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        username:
          type: string
          maxLength: 150
        full_name:
          type: string
          maxLength: 150
        avatar:
          type: string
          format: uri
          nullable: true
        headline:
          type: string
          maxLength: 200
        location:
          type: string
          maxLength: 100
        role:
          $ref: '#/components/schemas/RoleEnum'
        xp:
          type: integer
        level:
          type: integer
        streak_days:
          type: integer
        is_verified:
          type: boolean
        skills:
          type: string
          readOnly: true
        badges:
          type: string
          readOnly: true
        email:
          type: string
          format: email
          maxLength: 254
        bio:
          type: string
        github:
          oneOf:
          - type: string
            format: uri
            maxLength: 200
          - type: string
            maxLength: 0
        linkedin:
          oneOf:
          - type: string
            format: uri
            maxLength: 200
          - type: string
            maxLength: 0
        website:
          oneOf:
          - type: string
            format: uri
            maxLength: 200
          - type: string
            maxLength: 0
        availability:
          type: string
          maxLength: 50
        interests: {}
        last_active:
          type: string
          format: date-time
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        stats:
          type: string
          readOnly: true
      required:
      - badges
      - created_at
      - email
      - id
      - skills
      - stats
      - updated_at
      - username
  securitySchemes:
    jwtAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
