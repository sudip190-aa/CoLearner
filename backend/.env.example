SECRET_KEY=django-insecure-change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Local development defaults to SQLite unless DB_ENGINE=postgresql is set.
DB_ENGINE=sqlite3
DB_NAME=colearn
DB_USER=colearn
DB_PASSWORD=colearn
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Password-reset emails link to this URL (the React app).
FRONTEND_URL=http://localhost:5173

# Dev prints emails (incl. reset links) to the runserver console. For real delivery use the SMTP backend:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Colearn <no-reply@colearn.app>
